# gittr Pages fork — copy to `.env` for local `deno task dev`.
# Production values (no secrets): gittr repo
#   https://github.com/arbadacarbaYK/gittr/blob/main/infra/nsite-gateway/gittr-pages.production.env

# optional directory for per-cache Deno KV stores
# CACHE_PATH="./data/cache"

# How long to keep cached data (in seconds)
CACHE_TIME=3600

# How long to trust the cached preferred server for a blob (in seconds)
BLOB_SERVER_TTL=604800

# How long to avoid a server after it serves the wrong blob for a sha256 (in seconds)
BLOB_BAD_SOURCE_TTL=86400

# Max number of blob verification workers created on demand
VERIFY_WORKER_POOL_MAX=4

# Relays for NIP-65 (10002) and Blossom server list (10063)
LOOKUP_RELAYS=wss://user.kindpag.es,wss://purplepag.es

# Extra relays for site manifests (15128 / 35128 / 5128) — production adds wss://nsite.run
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net,wss://relay.nostr.band,wss://nsite.run

# CACHE_RELAYS=ws://localhost:4869

# Fallback Blossom when publisher has no kind 10063 (production: gittr Blossom first)
BLOSSOM_SERVERS=https://blossom.gittr.space,https://blossom.band,https://nostr.download

# BLOSSOM_PROXY=http://localhost:24242

MAX_FILE_SIZE="128 MB"

# Hostname only for built-in homepage / status (v3.6.1+); production: pages.gittr.space
PUBLIC_DOMAIN=pages.gittr.space

# ONION_HOST=https://<hostname>.onion

# Curator hex pubkey — gateway reads their NIP-51 kind 10000 mute list (see scripts/README.md)
# CURATION_USER=
# CURATION_REFRESH=600

# gittr deploy may set this from PUBLISHER_BLOCKLIST until mute list is on relays
# GITTR_SYNC_MUTED_PUBKEYS=
